  "onboardingWelcomeTitle": "Welcome to Megrim",
  "@onboardingWelcomeTitle": {
    "description": "First onboarding screen, title. Keep 'Megrim' untranslated."
  },
  "onboardingWelcomeBody": "A private, offline migraine diary. Everything stays on your device. Optionally, it can add weather and pressure context to your entries from Open-Meteo.com — you choose in a moment, and it is off unless you turn it on.",
  "@onboardingWelcomeBody": {
    "description": "First onboarding screen, body."
  },
  "onboardingGetStarted": "Get started",
  "@onboardingGetStarted": {
    "description": "Button on the first onboarding screen."
  },
  "onboardingBeforeYouBegin": "Before you begin",
  "@onboardingBeforeYouBegin": {
    "description": "Title of the onboarding step showing the medical disclaimer."
  },
  "onboardingAccept": "I understand and accept.",
  "@onboardingAccept": {
    "description": "[legal] Checkbox the user ticks to accept the medical disclaimer before using the app."
  },
  "onboardingContinue": "Continue",
  "@onboardingContinue": {
    "description": "Button to the next onboarding step."
  },
  "onboardingHomeTitle": "Your home location",
  "@onboardingHomeTitle": {
    "description": "Title of the onboarding step that asks for a home location."
  },
  "onboardingHomeBody": "Used on-device for daylight and season analytics, and — only if you enable weather enrichment in the next step — to fetch weather for your entries. Searching here sends the place name you type to Open-Meteo's geocoder to find coordinates; after that, only rounded (~1 km) coordinates would ever be sent, and only for weather. Prefer not to search online? Type GPS coordinates or a Plus Code instead — both are decoded on-device.",
  "@onboardingHomeBody": {
    "description": "[legal] Explains what the home location is used for and what is sent over the network. Keep it as precise as the English. 'Plus Code' is the name of Google's open location code format."
  },
  "onboardingWeatherTitle": "Weather enrichment",
  "@onboardingWeatherTitle": {
    "description": "Title of the onboarding step that asks whether to fetch weather. 'Enrichment' means adding weather data to entries."
  },
  "onboardingWeatherBody": "Megrim can fetch the weather around each migraine — temperature, humidity, barometric pressure, air quality — so Analytics can look for patterns like pressure swings before an attack.\n\nIf you turn this on, the entry's date and rounded (~1 km) coordinates are sent to Open-Meteo.com, a non-commercial weather service. Nothing else ever leaves your device: no account, no telemetry, and no server of ours.\n\nLeave it off and Megrim is fully offline. You can change this anytime in Settings.",
  "@onboardingWeatherBody": {
    "description": "[legal] Explains the weather opt-in and what is sent. Keep the blank lines between paragraphs. Keep it as precise as the English."
  },
  "onboardingWeatherSwitch": "Fetch weather for my entries",
