    "description": "Switch on the weather onboarding step."
  },
  "onboardingWeatherSwitchSubtitle": "Recommended if you want pressure correlations",
  "@onboardingWeatherSwitchSubtitle": {
    "description": "Under the weather switch during onboarding."
  },
  "onboardingFinish": "Finish",
  "@onboardingFinish": {
    "description": "Button that ends onboarding."
  },
