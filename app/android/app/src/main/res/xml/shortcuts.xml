<?xml version="1.0" encoding="utf-8"?>
<!-- App-icon shortcut (backlog #23, step 1): long-press the icon → "Log migraine". The intent is
     handled in MainActivity, which tells Flutter; Flutter starts the migraine only once the app is
     in the foreground and, if app lock is on, unlocked. No permission needed. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="log_migraine"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_log"
        android:shortcutShortLabel="@string/shortcut_log_short"
        android:shortcutLongLabel="@string/shortcut_log_long">
        <intent
            android:action="org.maegley.megrim.action.LOG_MIGRAINE"
            android:targetPackage="@string/shortcut_target_package"
            android:targetClass="org.maegley.megrim.MainActivity" />
    </shortcut>
</shortcuts>
