<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ backup rules. Megrim keeps everything on-device; cloud backup to the user's OWN
     Google account (device-encrypted, controlled by the user in Android settings) is allowed so
     data survives a device migration. Users who object can disable OS backups; manual
     export/import remains the canonical path. See docs/PRIVACY.md.

     The database is NOT in the "database" domain: path_provider's getApplicationDocumentsDirectory()
     is Context.getDir("flutter"), i.e. <data dir>/app_flutter/megrim.sqlite, which only the "root"
     domain covers. An <include> list backs up nothing it doesn't name, so without the root entry
     Android 12+ backups and device transfers silently carried no events or settings. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/" />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/" />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
