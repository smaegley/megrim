# macOS
.DS_Store
._*

# Secrets / signing (never commit)
*.jks
*.keystore
key.properties
android/key.properties
*.env

# Flutter/Dart build artifacts (app/ has its own .gitignore too)
build/
**/build/
app/.dart_tool/
.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
.gradle/

# IDE
*.iml
.idea/
.vscode/

# Personal diary data: Megrim exports and converted tracker histories must never be committed
# (a real one reached the public repo on 2026-10-08 and had to be erased from history).
# Test fixtures live under app/test/fixtures/ with their own names and are not matched.
megrim-export-*.json
megrim-export-*.csv
megrim-report-*.pdf
megrim-from-tracker*.json

# iOS store screenshots from tools/screenshots.sh, for uploading in App Store Connect (the Android
# set lives under fastlane/ and IS tracked, because F-Droid reads it from the repo).
screenshots/
