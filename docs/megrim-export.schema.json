{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smaegley/megrim/blob/main/docs/megrim-export.schema.json",
  "title": "Megrim export (megrim-export v1)",
  "description": "Import/export document for the Megrim migraine diary. See docs/IMPORT.md for semantics. This schema is slightly stricter than the app's importer (it also checks semantic ranges such as severity 1-10): a document that validates will both import successfully and make sense in the app.",
  "type": "object",
  "required": ["format", "format_version", "events"],
  "properties": {
    "format": { "const": "megrim-export" },
    "format_version": { "const": 1 },
    "exported_at": { "$ref": "#/$defs/isoTimestamp" },
    "app_version": { "type": "string" },
    "settings": {
      "type": "object",
      "properties": {
        "home_location": {
          "type": "object",
          "required": ["lat", "lon"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 },
            "label": { "type": "string" }
          }
        }
      }
    },
    "vocabularies": {
      "type": "object",
      "properties": {
        "trigger": { "$ref": "#/$defs/stringArray" },
        "head_location": { "$ref": "#/$defs/stringArray" },
        "medication": { "$ref": "#/$defs/stringArray" },
        "symptom": { "$ref": "#/$defs/stringArray" },
        "relief": { "$ref": "#/$defs/stringArray" }
      }
    },
    "medication_classes": {
      "type": "object",
      "description": "The class of each acute medication, keyed by the name used in meds_taken (app v1.0.8+, schema v5). Unknown classes are dropped on import.",
      "additionalProperties": { "$ref": "#/$defs/medClass" }
    },
    "preventives": {
      "type": "array",
      "description": "Preventive medications, taken daily and judged over months (app v1.0.8+, schema v5).",
      "items": { "$ref": "#/$defs/preventive" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "analytics": {
      "type": "object",
      "description": "Written by Megrim's exports: the app's computed dashboard and odds-ratio results at export time, for renderers. Ignored on import. See docs/IMPORT.md, 'The analytics block'.",
      "properties": {
        "computed_at": { "$ref": "#/$defs/isoTimestamp" },
        "bucketing": { "type": "string", "enum": ["event-offset"], "description": "How local-calendar day buckets were derived: per-event stored offsets (app v1.0.4+); timezone then applies only to events without one." },
        "timezone": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "offset_minutes": { "type": "integer" }
          }
        },
        "home_location": {
          "type": ["object", "null"],
          "properties": {
            "lat": { "type": "number" },
            "lon": { "type": "number" },
            "label": { "type": "string" }
          }
        },
        "method": { "type": "string" },
        "dashboard": {
          "type": "object",
          "properties": {
            "summary": { "type": "object" },
            "by_year": { "type": "array", "items": { "type": "object" } },
            "migraine_days_last_30": { "type": "integer", "description": "Distinct migraine days in the 30 days ending on the export date (app v1.0.7+). A day counts once however many entries cover it; a multi-day migraine counts every day it spans." },
            "migraine_days_avg_last_3_months": { "type": ["number", "null"], "description": "Mean migraine days per month over the last 3 complete calendar months (app v1.0.7+). Null until 3 complete months have passed since the first entry's month." },
            "migraine_days_by_month": {
              "type": "array",
              "description": "Distinct migraine days per calendar month, oldest first, from the first entry's month through the export month, zero months included (app v1.0.7+).",
              "items": {
                "type": "object",
                "properties": {
                  "month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
                  "days": { "type": "integer" },
                  "days_without_headache": { "type": "integer", "description": "Of days, those covered only by attacks without headache (app v1.0.8+). A day with both kinds counts as a headache day." }
                }
              }
            },
            "migraine_days_without_headache_last_30": { "type": "integer", "description": "Of migraine_days_last_30, the days covered only by attacks without headache (app v1.0.8+)." },
            "without_headache": {
              "type": ["object", "null"],
              "description": "Attacks without headache (headache_present false), app v1.0.8+. Null when there are none.",
              "properties": {
                "events": { "type": "integer" },
                "pct_of_events": { "type": "number" },
                "with_aura": { "type": "integer" },
                "with_vertigo": { "type": "integer", "description": "Vertigo or Dizziness ticked, and no aura." },
                "other": { "type": "integer" },
                "median_duration_hours": { "type": ["number", "null"] },
                "symptoms": { "$ref": "#/$defs/labeledCounts" }
              }
            },
            "impact": {
              "type": ["object", "null"],
              "description": "Impact-day counts on the migraine-day rule; each day takes the worst impact recorded on it (app v1.0.8+). The 3-month averages are null until 3 complete months have passed since the first impact was recorded. Null until an entry has an impact.",
              "properties": {
                "unable_days_last_30": { "type": "integer" },
                "reduced_days_last_30": { "type": "integer" },
                "recorded_days_last_30": { "type": "integer" },
                "unable_days_avg_last_3_months": { "type": ["number", "null"] },
                "reduced_days_avg_last_3_months": { "type": ["number", "null"] }
              }
            },
            "symptom_frequency": { "$ref": "#/$defs/labeledCounts" },
            "medication_days": {
              "type": ["object", "null"],
              "description": "Distinct days with acute medication, per class (app v1.0.8+). Null until an entry has a medication. See docs/METHODS.md.",
              "properties": {
                "days_last_30": { "type": "integer" },
                "by_class_last_30": { "$ref": "#/$defs/classDays" },
                "by_month": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
                      "days": { "type": "integer" },
                      "by_class": { "$ref": "#/$defs/classDays" },
                      "overuse_class_days": { "type": "integer", "description": "Days with any of triptan, ergot, opioid, combination_analgesic, simple_analgesic." },
                      "levels_reached": {
                        "type": "array",
                        "items": { "enum": ["triptan", "ergot", "opioid", "combination_analgesic", "simple_analgesic", "mixed"] }
                      }
                    }
                  }
                },
                "overuse_notice_months": {
                  "type": ["array", "null"],
                  "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
                  "description": "The last 3 complete months, when each reached a reference level; null otherwise."
                },
                "unclassified_names": { "$ref": "#/$defs/stringArray" }
              }
            },
            "what_helped": {
              "type": "array",
              "description": "Per medication and relief method: helped / not helped / unknown (app v1.0.8+). helped_pct leaves unknowns out.",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "kind": { "enum": ["medication", "relief"] },
                  "tried": { "type": "integer" },
                  "helped": { "type": "integer" },
                  "not_helped": { "type": "integer" },
                  "unknown": { "type": "integer" },
                  "helped_pct": { "type": ["integer", "null"] }
                }
              }
            },
            "by_day_of_week": { "$ref": "#/$defs/labeledCounts" },
            "by_time_of_day": { "$ref": "#/$defs/labeledCounts" },
            "by_season": { "$ref": "#/$defs/labeledCounts" },
            "by_moon_phase": { "$ref": "#/$defs/labeledCounts" },
            "by_daylight": { "$ref": "#/$defs/labeledCounts" },
            "pressure_delta": { "$ref": "#/$defs/labeledCounts" },
            "trigger_frequency": { "$ref": "#/$defs/labeledCounts" },
            "away_from_home": {
              "type": ["object", "null"],
              "description": "Entries recorded more than threshold_km from the home location (app v1.0.5+). Null when no home location is set or no entry has coordinates; away_events 0 means the user stayed near home. Descriptive only — deliberately not a correlation factor.",
              "properties": {
                "located_events": { "type": "integer" },
                "away_events": { "type": "integer" },
                "away_pct": { "type": "number" },
                "threshold_km": { "type": "number" },
                "farthest_km": { "type": ["number", "null"] },
                "away_places": { "$ref": "#/$defs/labeledCounts" }
              }
            }
          }
        },
        "correlations": {
          "type": "object",
          "required": ["available"],
          "properties": {
            "available": { "type": "boolean" },
            "reason": { "type": ["string", "null"] },
            "total_events": { "type": "integer" },
            "total_migraine_days": { "type": "integer" },
            "total_days_in_range": { "type": "integer", "description": "Days compared: the study window minus excluded_mid_attack_days (app v1.0.7+)." },
            "excluded_mid_attack_days": { "type": "integer", "description": "Days in the middle of a multi-day migraine (not its start day), left out of every factor table because no new attack can start on them (app v1.0.7+)." },
            "base_rate_pct": { "type": "number" },
            "top_factors": { "type": "array", "items": { "$ref": "#/$defs/topFactor" } },
            "factors": {
              "type": "object",
              "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/factorRow" } }
            },
            "caveats": { "$ref": "#/$defs/stringArray" }
          }
        }
      }
    }
  },
  "$defs": {
    "labeledCounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "count"],
        "properties": { "label": { "type": "string" }, "count": { "type": "integer" } }
      }
    },
    "factorRow": {
      "type": "object",
      "required": ["bucket", "migraine_days", "total_days", "migraine_rate_pct", "odds_ratio"],
      "properties": {
        "bucket": { "type": "string" },
        "migraine_days": { "type": "integer" },
        "total_days": { "type": "integer" },
        "migraine_rate_pct": { "type": "number" },
        "odds_ratio": { "type": "number" }
      }
    },
    "topFactor": {
      "type": "object",
      "required": ["factor", "condition", "odds_ratio", "migraine_days", "total_days", "migraine_rate_pct"],
      "properties": {
        "factor": { "type": "string" },
        "condition": { "type": "string" },
        "odds_ratio": { "type": "number" },
        "migraine_days": { "type": "integer" },
        "total_days": { "type": "integer" },
        "migraine_rate_pct": { "type": "number" }
      }
    },
    "isoTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt ]\\d{2}:\\d{2}",
      "description": "ISO-8601 timestamp. Always include a timezone (Z or +/-hh:mm); bare local timestamps are interpreted in the importing phone's zone."
    },
    "isoTimestampOrNull": {
      "anyOf": [{ "$ref": "#/$defs/isoTimestamp" }, { "type": "null" }]
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "event": {
      "type": "object",
      "required": ["id", "started_at"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Any unique string; merge-dedup key. Keep stable across re-imports."
        },
        "started_at": { "$ref": "#/$defs/isoTimestamp" },
        "ended_at": {
          "$ref": "#/$defs/isoTimestampOrNull",
          "description": "Null or omitted = ongoing."
        },
        "started_at_offset_minutes": {
          "type": ["integer", "null"],
          "minimum": -900,
          "maximum": 900,
          "description": "Minutes east of UTC of the zone the event was logged in; local-calendar buckets use it (app v1.0.4+). Null/absent: an explicit offset on started_at is used, else the phone's zone."
        },
        "ended_at_offset_minutes": {
          "type": ["integer", "null"],
          "minimum": -900,
          "maximum": 900,
          "description": "Same for ended_at; falls back to the start offset."
        },
        "severity": {
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 10 },
            { "type": "null" }
          ],
          "description": "10 = worst."
        },
        "location_head": { "$ref": "#/$defs/stringArray" },
        "aura_present": { "type": ["boolean", "null"] },
        "aura_description": { "type": ["string", "null"] },
        "headache_present": {
          "type": ["boolean", "null"],
          "description": "False = an attack without headache (aura only, vertigo, or other symptoms with no pain). Null = not recorded, and counts as a headache. App v1.0.8+ (schema v4)."
        },
        "symptoms": {
          "$ref": "#/$defs/stringArray",
          "description": "Symptoms of this attack, e.g. [\"Nausea\", \"Vertigo\"]. Free text. App v1.0.8+."
        },
        "impact": {
          "anyOf": [
            { "enum": ["normal", "reduced", "unable"] },
            { "type": "null" }
          ],
          "description": "How far the attack stopped the user that day: functioned normally, reduced function, unable to function. App v1.0.8+."
        },
        "meds_taken": {
          "type": "array",
          "items": { "$ref": "#/$defs/med" }
        },
        "relief_tried": {
          "type": "array",
          "description": "Non-drug relief tried for this attack. App v1.0.8+ (schema v5).",
          "items": { "$ref": "#/$defs/relief" }
        },
        "triggers_suspected": { "$ref": "#/$defs/stringArray" },
        "sleep_hours_prior": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 24 },
            { "type": "null" }
          ]
        },
        "stress_level": {
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 10 },
            { "type": "null" }
          ]
        },
        "foods_notable": { "$ref": "#/$defs/stringArray" },
        "notes": { "type": ["string", "null"] },
        "geo_lat": {
          "anyOf": [
            { "type": "number", "minimum": -90, "maximum": 90 },
            { "type": "null" }
          ]
        },
        "geo_lon": {
          "anyOf": [
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "null" }
          ]
        },
        "geo_label": { "type": ["string", "null"] },
        "created_at": { "$ref": "#/$defs/isoTimestamp" },
        "updated_at": { "$ref": "#/$defs/isoTimestamp" },
        "derived": {
          "$ref": "#/$defs/derived",
          "description": "Megrim-computed enrichment. Omit for external imports - the app recomputes it."
        }
      }
    },
    "med": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "dose": { "type": ["string", "null"] },
        "time": {
          "type": ["string", "null"],
          "description": "ISO-8601 UTC preferred (lets the app's edit dialog prefill its time picker); any string is tolerated and displayed as-is."
        },
        "helped": {
          "type": ["boolean", "null"],
          "description": "true = helped, false = didn't; null or omitted = unknown."
        }
      }
    },
    "relief": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "helped": {
          "type": ["boolean", "null"],
          "description": "true = helped, false = didn't; null or omitted = unknown."
        }
      }
    },
    "medClass": {
      "enum": ["triptan", "ergot", "opioid", "combination_analgesic", "simple_analgesic", "gepant", "ditan", "antiemetic", "other"]
    },
    "classDays": {
      "type": "object",
      "description": "Days per class; the key unclassified counts medications with no class.",
      "additionalProperties": { "type": "integer" }
    },
    "preventive": {
      "type": "object",
      "required": ["id", "name", "started_on"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "dose": { "type": ["string", "null"] },
        "started_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "stopped_on": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            { "type": "null" }
          ],
          "description": "Null = still taking it."
        },
        "notes": { "type": ["string", "null"] },
        "created_at": { "$ref": "#/$defs/isoTimestamp" },
        "updated_at": { "$ref": "#/$defs/isoTimestamp" }
      }
    },
    "derived": {
      "type": "object",
      "properties": {
        "day_of_week": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 6 },
            { "type": "null" }
          ],
          "description": "0 = Monday ... 6 = Sunday, in the event's local time."
        },
        "season": {
          "enum": ["Winter", "Spring", "Summer", "Autumn", null]
        },
        "time_of_day_bucket": {
          "enum": ["morning", "afternoon", "evening", "night", null]
        },
        "daylight_hours": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 24 },
            { "type": "null" }
          ]
        },
        "sunrise_utc": { "$ref": "#/$defs/isoTimestampOrNull" },
        "sunset_utc": { "$ref": "#/$defs/isoTimestampOrNull" },
        "moon_phase": {
          "enum": [
            "New Moon",
            "Waxing Crescent",
            "First Quarter",
            "Waxing Gibbous",
            "Full Moon",
            "Waning Gibbous",
            "Last Quarter",
            "Waning Crescent",
            null
          ]
        },
        "moon_illumination": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "temp_c": { "type": ["number", "null"] },
        "humidity_pct": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 100 },
            { "type": "null" }
          ]
        },
        "pressure_hpa": { "type": ["number", "null"] },
        "precipitation_mm": { "type": ["number", "null"] },
        "pressure_delta_24h": { "type": ["number", "null"] },
        "pressure_delta_48h": { "type": ["number", "null"] },
        "aqi": {
          "anyOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "enriched_at": { "$ref": "#/$defs/isoTimestampOrNull" },
        "enrich_error": { "type": ["string", "null"] }
      }
    }
  }
}
